# Copy to /etc/vook/server.env on the VPS and fill it in. This file never goes into git.
NODE_ENV=production
PORT=4000
# Only Nginx on this machine may reach the API.
HOST=127.0.0.1

# MongoDB Atlas connection string (add the VPS IP address to Atlas "Network Access").
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=vook

# The public address people open in the browser.
CORS_ORIGIN=https://influencersfeed.com
COOKIE_SECURE=true

# One Nginx in front of the API.
TRUST_PROXY=1

# 32 random bytes in base64. Create with:  openssl rand -base64 32
# Keep a copy somewhere safe: if it is lost, saved payment and email passwords cannot be read again.
SECRETS_KEY=

# Never create demo accounts on a real server.
SEED_DEMO=false

# Sign-in bot protection. `auto` is on in production.
BOT_GUARD=auto

# Files people upload (outside the deploy folder so a deploy never deletes them).
UPLOAD_DIR=/var/lib/vook/uploads
MAX_UPLOAD_MB=10

LOG_LEVEL=info
