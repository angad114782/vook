NODE_ENV=development
PORT=4000
# Use your own MongoDB connection string. Never commit the real one.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=vook_demo
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
# Seeds demo companies/users (password Demo@123). Keep false in production.
SEED_DEMO=true
SEED_EMPLOYEES=200
